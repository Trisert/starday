# Public base URL of the site, used for canonical/OG metadata, sitemap.xml,
# robots.txt and share links. Set it to the real production domain in the
# Vercel project (Project -> Settings -> Environment Variables), e.g.
#   NEXT_PUBLIC_SITE_URL=https://starday-ashy.vercel.app
# When unset, the app falls back to VERCEL_PROJECT_PRODUCTION_URL, then
# VERCEL_URL (both provided by Vercel), then http://localhost:3000 locally.
# Note: NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_SITE_URL=

# NASA API key (https://api.nasa.gov/) — required in production.
# For local development you can use the literal "DEMO_KEY" which is
# rate-limited to ~30 req/hour per IP. Example:
#   NASA_API_KEY=DEMO_KEY
NASA_API_KEY=
